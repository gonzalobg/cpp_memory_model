C mp-faddrlx-sna-lacq-faddrlx-undef
{ [x] = 0; [y] = 0; }

P0 (int* x, int* y) {
  atomic_fetch_add_explicit(x, 1, memory_order_relaxed);
  *y = 1;
}

P1 (int* x, int* y) {
  int a = atomic_load_explicit(y, memory_order_acquire);
  int b = 0;
  if (a != 0) {
    b = atomic_fetch_add_explicit(x, 0, memory_order_relaxed);
  }
}

forall(1:b=0 \/ 1:b=1)