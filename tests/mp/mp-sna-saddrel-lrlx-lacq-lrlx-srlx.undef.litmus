C mp-sna-saddrel-lrlx-lacq-lrlx-undef
{ [x] = 0; [y] = 0; }

P0 (int* x, int* y) {
  *x = 1;
  atomic_store_add_explicit(y, 1, memory_order_release);
}

P1 (int* x, int* y) {
  int a = atomic_load_explicit(y, memory_order_relaxed);
  int c = atomic_load_explicit(y, memory_order_acquire);
  int b = 0;
  if (a != 0) {
    b = atomic_load_explicit(x, memory_order_relaxed);
  }
}

P2 (int* y) {
  atomic_store_explicit(y, 0, memory_order_relaxed);
}

forall(1:b=0 \/ 1:b=1)