C mp-sna-faddrel-faddrlx-faddrlx-facq-lrlx
{ [x] = 0; [y] = 0; }

P0 (int* x, int* y) {
  *x = 1;
  atomic_fetch_add_explicit(y, 1, memory_order_release);
  atomic_fetch_add_explicit(y, 1, memory_order_relaxed);
}

P1 (int* x, int* y) {
  int a = atomic_fetch_add_explicit(y, 0, memory_order_relaxed);
  atomic_thread_fence(memory_order_acquire);
  int b = 0;
  if (a != 0) {
    b = atomic_load_explicit(x, memory_order_relaxed);
  }
}

~exists(~1:a=0 /\ 1:b=0)