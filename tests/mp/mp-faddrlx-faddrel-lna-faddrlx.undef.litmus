C mp-faddrlx-faddrel-lna-faddrlx-undef
{ [x] = 0; [y] = 0; }

P0 (int* x, int* y) {
  atomic_fetch_add_explicit(x, 1, memory_order_relaxed);
  atomic_fetch_add_explicit(y, 1, memory_order_release);
}

P1 (int* x, int* y) {
  int a = *y;
  int b = 0;
  if (a != 0) {
    b = atomic_fetch_add_explicit(x, 0, memory_order_relaxed);
  }
}

forall(1:b=0 \/ 1:b=1)