C mp-srlx-frel-faddrlx-lrlx-lacq-lna
{ [x] = 0; [y] = 0; }

P0 (int* x, int* y) {
  atomic_store_explicit(x, 1, memory_order_relaxed);
  atomic_thread_fence(memory_order_release);
  atomic_fetch_add_explicit(y, 1, memory_order_relaxed);
}

P1 (int* x, int* y) {
  int a = atomic_load_explicit(y, memory_order_relaxed);
  int c = atomic_load_explicit(y, memory_order_acquire);
  int b = 0;
  if (a != 0) {
    b = *x;
  }
}

~exists(~1:a=0 /\ 1:b=0)