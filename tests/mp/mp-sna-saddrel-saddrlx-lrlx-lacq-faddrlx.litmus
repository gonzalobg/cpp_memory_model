C mp-sna-saddrel-saddrlx-lrlx-lacq-faddrlx
{ [x] = 0; [y] = 0; }

P0 (int* x, int* y) {
  *x = 1;
  atomic_store_add_explicit(y, 1, memory_order_release);
  atomic_store_add_explicit(y, 1, memory_order_relaxed);
}

P1 (int* x, int* y) {
  int a = atomic_load_explicit(y, memory_order_relaxed);
  int c = atomic_load_explicit(y, memory_order_acquire);
  int b = 0;
  if (a != 0) {
    b = atomic_fetch_add_explicit(x, 0, memory_order_relaxed);
  }
}

~exists(~1:a=0 /\ 1:b=0)