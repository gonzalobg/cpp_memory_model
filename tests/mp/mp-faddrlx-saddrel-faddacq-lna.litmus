C mp-faddrlx-saddrel-faddacq-lna
{ [x] = 0; [y] = 0; }

P0 (int* x, int* y) {
  atomic_fetch_add_explicit(x, 1, memory_order_relaxed);
  atomic_store_add_explicit(y, 1, memory_order_release);
}

P1 (int* x, int* y) {
  int a = atomic_fetch_add_explicit(y, 0, memory_order_acquire);
  int b = 0;
  if (a != 0) {
    b = *x;
  }
}

~exists(~1:a=0 /\ 1:b=0)