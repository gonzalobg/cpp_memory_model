C mp-sna-frel-2faddrlx-saddrlx-facq-faddrlx-undef
{ [x] = 0; [y] = 0; }

P0 (int* x, int* y) {
  *x = 1;
  atomic_thread_fence(memory_order_release);
  atomic_fetch_add_explicit(y, 1, memory_order_relaxed);
  atomic_fetch_add_explicit(y, 1, memory_order_relaxed);
}

P1 (int* x, int* y) {
  atomic_store_add_explicit(y, 1, memory_order_relaxed);
  atomic_thread_fence(memory_order_acquire);
  int b = atomic_fetch_add_explicit(x, 0, memory_order_relaxed);
}

filter ([y]=3)
forall(1:b=0 \/ 1:b=1)