FROM ghcr.io/graalvm/native-image-community:25 AS graalvm

FROM ubuntu:24.04

ARG DEBIAN_FRONTEND=noninteractive

# Update Ubuntu Software repository
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y build-essential software-properties-common git graphviz sudo wget maven z3 clang zlib1g-dev

# Use the official multi-architecture GraalVM toolchain with Native Image.
COPY --from=graalvm /usr/lib64/graalvm/graalvm-community-java25 /opt/graalvm

ENV GRAALVM_HOME=/opt/graalvm
ENV JAVA_HOME=$GRAALVM_HOME
ENV PATH=$GRAALVM_HOME/bin:$PATH

# Install Dat3M
RUN cd home && \
    git clone --branch development https://github.com/hernanponcedeleon/Dat3M.git && \
    cd Dat3M && \
    mvn clean -Pnative install -DskipTests && \
    test -x dartagnan/target/dartagnan

ENV DAT3M_HOME=/home/Dat3M
ENV DAT3M_OUTPUT=/src/target_dat3m
ENV LD_LIBRARY_PATH=/home/Dat3M/dartagnan/target/libs
ENV PATH=$DAT3M_HOME/dartagnan/target:$PATH
ENV CFLAGS="-I$DAT3M_HOME/include"
ENV OPTFLAGS="-mem2reg -sroa -early-cse -indvars -loop-unroll -fix-irreducible -loop-simplify -simplifycfg -gvn"
